{
  "name": "videochat-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de videochat aleatorio 1v1 tipo Omegle/Uhmegle — monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:signaling dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:signaling": "npm run dev --workspace apps/signaling",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
