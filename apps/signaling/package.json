    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.7.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "prisma": "^6.19.3",
    "typescript": "^5.5.4"
  }
