{
  "name": "@videochat/signaling",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de señalización: Socket.IO + matchmaking con cola en Redis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
