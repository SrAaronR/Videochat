# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# --- PostgreSQL (denuncias, baneos, métricas de moderación) ---
POSTGRES_USER=videochat
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=videochat
# Solo para desarrollo sin Docker (dentro de compose se construye sola).
DATABASE_URL=postgresql://videochat:cambia-esta-contrasena@localhost:5432/videochat

# --- Moderación (Fase 4) ---
# Contraseña del panel /admin (obligatoria para que el panel funcione).
ADMIN_PASSWORD=cambia-esta-contrasena-admin
# Secreto de firma de los JWT del panel (si se omite, se genera uno por
# arranque y las sesiones caducan al reiniciar).
ADMIN_JWT_SECRET=cambia-este-secreto
# Sal del hash de IPs (nunca se guarda la IP en claro).
HASH_SALT=cambia-esta-sal
# Términos prohibidos adicionales, separados por comas (minúsculas).
TERMINOS_PROHIBIDOS=
# Rate limiting por IP.
RATE_MATCHES_POR_MINUTO=20
RATE_MENSAJES_POR_SEGUNDO=5
RATE_DENUNCIAS_POR_MINUTO=5
# Política del detector NSFW automático del cliente:
#   off   = desactivado (ni aviso ni baneo)
#   aviso = solo avisa y guarda evidencia para el panel, NO banea (por defecto)
#   auto  = estricto: 1.er aviso y a la reincidencia banea (como la spec)
# El auto-ban por ML de cliente da falsos positivos; para producción real se
# recomienda 'aviso' + revisión humana de denuncias, o 'auto' con umbral alto.
MODERACION_NSFW=aviso
# Sala de vigilancia (supervisión humana): on | off. Cuando está 'on', cada
# cliente envía capturas periódicas de su cámara al panel /admin (pestaña
# Vigilancia) y se muestra al usuario el aviso "moderación activa".
# IMPORTANTE: si la activas, debes declararlo en tus Términos y Política de
# Privacidad (aquí ya viene reflejado). Solo aplica al modo vídeo.
VIGILANCIA=on
# Umbral (0..1) e intervalo (ms) del detector NSFW del cliente.
NEXT_PUBLIC_NSFW_UMBRAL=0.7
NEXT_PUBLIC_NSFW_INTERVALO_MS=7000
# URL del model.json de NSFWJS. El modelo mobilenet_v2 (MIT) ya va
# autoalojado en apps/web/public/modelos/nsfw. Cámbiala si alojas otro
# modelo compatible (mismas 5 clases: Drawing/Hentai/Neutral/Porn/Sexy).
NEXT_PUBLIC_NSFWJS_MODEL_URL=/modelos/nsfw/model.json

# --- Señalización ---
# URL del servidor de señalización vista DESDE EL NAVEGADOR.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000
# Orígenes permitidos para CORS en el signaling (separados por comas).
CORS_ORIGIN=http://localhost:3000
# Solo para desarrollo sin Docker (dentro de compose se usa redis://redis:6379).
REDIS_URL=redis://localhost:6379
# País asumido cuando GeoIP no resuelve la IP (p. ej. en localhost).
# Útil en desarrollo para probar el filtro de país; en producción déjalo vacío.
PAIS_POR_DEFECTO=
# Ventana (ms) durante la que solo se acepta match por intereses en común.
# 15000 según especificación; se puede bajar en desarrollo para probar rápido.
VENTANA_INTERESES_MS=15000
# Ventana (ms) durante la que el filtro de país es obligatorio; pasada, se
# empareja con cualquier país (preferencia con margen) para no dejar al
# usuario esperando si no hay nadie de ese país.
VENTANA_PAIS_MS=6000

# --- coturn (TURN propio) ---
TURN_REALM=videochat.local
TURN_USER=videochat
TURN_PASSWORD=cambia-esta-contrasena

# --- Servidores ICE del cliente (se incrustan en el build de la web) ---
# STUN públicos de Google por defecto; se puede sobreescribir con una lista
# separada por comas.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN de respaldo (el coturn de docker-compose). En producción usa tu dominio
# (turn:turn.tudominio.com:3478) y credenciales efímeras — ver deuda técnica.
NEXT_PUBLIC_TURN_URL=turn:localhost:3478
NEXT_PUBLIC_TURN_USERNAME=videochat
NEXT_PUBLIC_TURN_PASSWORD=cambia-esta-contrasena
